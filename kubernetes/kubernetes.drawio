
<mxfile host="app.diagrams.net" version="24.7.17">
  <diagram id="k8s-architecture" name="Arquitetura Kubernetes">
    <mxGraphModel dx="1400" dy="900" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1600" pageHeight="1100" math="0" shadow="0">
      <root>
        <mxCell id="0"/>
        <mxCell id="1" parent="0"/>

        <!-- Titulo -->
        <mxCell id="title" value="ARQUITETURA KUBERNETES — MINIKUBE" style="text;html=1;align=center;verticalAlign=middle;fontSize=24;fontStyle=1;fontColor=#17365D;" vertex="1" parent="1">
          <mxGeometry x="390" y="20" width="700" height="45" as="geometry"/>
        </mxCell>
        <mxCell id="subtitle" value="Implantação de aplicação com Pod e Service NodePort" style="text;html=1;align=center;verticalAlign=middle;fontSize=14;fontColor=#526579;" vertex="1" parent="1">
          <mxGeometry x="440" y="65" width="600" height="30" as="geometry"/>
        </mxCell>

        <!-- Desenvolvedor e kubectl -->
        <mxCell id="developer" value="&lt;b&gt;DESENVOLVEDOR&lt;/b&gt;&lt;br&gt;Define os manifestos YAML&lt;br&gt;pod.yml e service.yml" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#E8F0FE;strokeColor=#4285F4;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="40" y="160" width="200" height="90" as="geometry"/>
        </mxCell>
        <mxCell id="kubectl" value="&lt;b&gt;kubectl&lt;/b&gt;&lt;br&gt;Ferramenta de linha de comando&lt;br&gt;Aplica e consulta recursos" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAF7;strokeColor=#3D85C6;fontSize=14;spacing=8;" vertex="1" parent="1">
          <mxGeometry x="300" y="160" width="210" height="90" as="geometry"/>
        </mxCell>

        <!-- Control Plane -->
        <mxCell id="controlplane" value="KUBERNETES CONTROL PLANE — PLANO DE CONTROLE" style="swimlane;html=1;startSize=35;horizontal=1;rounded=1;whiteSpace=wrap;fillColor=#D9EAD3;swimlaneFillColor=#F3F8F1;strokeColor=#6AA84F;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="560" y="125" width="610" height="340" as="geometry"/>
        </mxCell>
        <mxCell id="apiserver" value="&lt;b&gt;API Server&lt;/b&gt;&lt;br&gt;Recebe e valida solicitações&lt;br&gt;de acesso à API" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="190" width="245" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="etcd" value="&lt;b&gt;etcd&lt;/b&gt;&lt;br&gt;Armazena o estado e os dados&lt;br&gt;do cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="875" y="190" width="255" height="80" as="geometry"/>
        </mxCell>
        <mxCell id="scheduler" value="&lt;b&gt;Scheduler&lt;/b&gt;&lt;br&gt;Escolhe o Node onde um Pod&lt;br&gt;deve ser agendado" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#E69138;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="590" y="305" width="245" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="controller" value="&lt;b&gt;Controller Manager&lt;/b&gt;&lt;br&gt;Executa controladores que reconciliam&lt;br&gt;o estado desejado do cluster" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#FCE5CD;strokeColor=#E69138;fontSize=13;spacing=6;" vertex="1" parent="1">
          <mxGeometry x="875" y="305" width="255" height="75" as="geometry"/>
        </mxCell>
        <mxCell id="controlnote" value="O plano de controle coordena o cluster. O Minikube desta atividade executa o plano de controle e o Node no mesmo ambiente local." style="text;html=1;align=center;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#526579;" vertex="1" parent="1">
          <mxGeometry x="585" y="395" width="560" height="45" as="geometry"/>
        </mxCell>

        <!-- Node -->
        <mxCell id="node" value="NODE — MINIKUBE" style="swimlane;html=1;startSize=35;horizontal=1;rounded=1;whiteSpace=wrap;fillColor=#D9EAF7;swimlaneFillColor=#F4F9FC;strokeColor=#3D85C6;fontStyle=1;fontSize=16;" vertex="1" parent="1">
          <mxGeometry x="350" y="535" width="820" height="385" as="geometry"/>
        </mxCell>
        <mxCell id="kubelet" value="&lt;b&gt;Kubelet&lt;/b&gt;&lt;br&gt;Agente do Node que acompanha&lt;br&gt;a execução dos Pods" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EADCF8;strokeColor=#9673A6;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="380" y="590" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="kubeproxy" value="&lt;b&gt;kube-proxy&lt;/b&gt;&lt;br&gt;Implementa regras de rede&lt;br&gt;para Services no Node" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#EADCF8;strokeColor=#9673A6;fontSize=12;spacing=5;" vertex="1" parent="1">
          <mxGeometry x="600" y="590" width="190" height="70" as="geometry"/>
        </mxCell>
        <mxCell id="service" value="&lt;b&gt;Service: meu-app-service&lt;/b&gt;&lt;br&gt;Tipo: NodePort&lt;br&gt;Porta do Service: 5000&lt;br&gt;NodePort: 30080&lt;br&gt;Seleciona app=meu-app" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#D9EAD3;strokeColor=#6AA84F;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="405" y="710" width="300" height="125" as="geometry"/>
        </mxCell>
        <mxCell id="pod" value="&lt;b&gt;Pod: meu-app-pod&lt;/b&gt;&lt;br&gt;Label: app=meu-app&lt;br&gt;Estado observado: Running&lt;br&gt;&lt;br&gt;&lt;b&gt;Contêiner: meu-app&lt;/b&gt;&lt;br&gt;Imagem: sergiorfeitosa/meu_app_python:1.0&lt;br&gt;Porta configurada: 5000" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#CFE2F3;strokeColor=#3D85C6;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="775" y="700" width="355" height="155" as="geometry"/>
        </mxCell>

        <!-- Usuario -->
        <mxCell id="user" value="&lt;b&gt;USUÁRIO / NAVEGADOR&lt;/b&gt;&lt;br&gt;Acesso pelo endereço local&lt;br&gt;retornado pelo Minikube" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F4CCCC;strokeColor=#CC0000;fontSize=13;spacing=7;" vertex="1" parent="1">
          <mxGeometry x="40" y="730" width="235" height="95" as="geometry"/>
        </mxCell>

        <!-- ReplicaSet -->
        <mxCell id="replicaset" value="&lt;b&gt;ReplicaSet — conceito&lt;/b&gt;&lt;br&gt;Mantém o número desejado de réplicas de Pods quando criado e gerenciado, normalmente, por um Deployment.&lt;br&gt;&lt;br&gt;&lt;i&gt;Não foi criado nesta execução: o Pod foi aplicado diretamente por pod.yml.&lt;/i&gt;" style="rounded=1;whiteSpace=wrap;html=1;fillColor=#F3E5F5;strokeColor=#8E7CC3;fontSize=12;spacing=8;dashed=1;" vertex="1" parent="1">
          <mxGeometry x="40" y="350" width="450" height="125" as="geometry"/>
        </mxCell>

        <!-- Fluxo de acesso -->
        <mxCell id="e1" value="comandos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4285F4;strokeWidth=2;" edge="1" parent="1" source="developer" target="kubectl">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e2" value="solicitações à API" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#4285F4;strokeWidth=2;" edge="1" parent="1" source="kubectl" target="apiserver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e3" value="consulta / gravação" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;startArrow=block;startFill=1;endFill=1;strokeColor=#D6B656;" edge="1" parent="1" source="apiserver" target="etcd">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e4" value="agenda Pods" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#E69138;" edge="1" parent="1" source="scheduler" target="apiserver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e5" value="observa e reconcilia recursos" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#E69138;" edge="1" parent="1" source="controller" target="apiserver">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Fluxo da aplicacao -->
        <mxCell id="e6" value="acesso local :30080" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#CC0000;strokeWidth=2;" edge="1" parent="1" source="user" target="service">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>
        <mxCell id="e7" value="encaminha para o endpoint :5000" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;strokeColor=#38761D;strokeWidth=2;" edge="1" parent="1" source="service" target="pod">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- ReplicaSet conceptual relation -->
        <mxCell id="e8" value="gerencia réplicas quando usado" style="edgeStyle=orthogonalEdgeStyle;rounded=0;orthogonalLoop=1;jettySize=auto;html=1;endArrow=block;endFill=1;dashed=1;strokeColor=#8E7CC3;" edge="1" parent="1" source="replicaset" target="pod">
          <mxGeometry relative="1" as="geometry"/>
        </mxCell>

        <!-- Footer -->
        <mxCell id="legend" value="Legenda: setas contínuas = fluxos principais; seta tracejada = relação conceitual do ReplicaSet. A URL local do Minikube pode usar uma porta temporária diferente de 30080 no Windows com driver Docker." style="text;html=1;align=left;verticalAlign=middle;whiteSpace=wrap;fontSize=11;fontColor=#526579;" vertex="1" parent="1">
          <mxGeometry x="40" y="970" width="1200" height="50" as="geometry"/>
        </mxCell>
      </root>
    </mxGraphModel>
  </diagram>
